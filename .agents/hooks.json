{
  "inject-brains-protocol": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "powershell.exe -ExecutionPolicy Bypass -NoProfile -File scripts/pre-invocation.ps1"
      }
    ]
  },
  "check-uncommitted-changes": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "powershell.exe -ExecutionPolicy Bypass -NoProfile -File scripts/git-reminder.ps1"
      }
    ]
  }
}
