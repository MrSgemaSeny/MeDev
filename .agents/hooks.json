{
  "enforce-commits-and-journal": {
    "Stop": [
      {
        "type": "command",
        "command": "powershell.exe -ExecutionPolicy Bypass -File .agents/hooks/stop-check-commits.ps1"
      }
    ]
  },
  "force-init": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "powershell.exe -ExecutionPolicy Bypass -File .agents/hooks/force-init.ps1"
      }
    ]
  },
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File .agents/hooks/safety-gate.ps1"
          }
        ]
      }
    ]
  }
}
