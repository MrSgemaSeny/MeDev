# MeDev Artillery Smoke / Load Testing Environment Variables
# Скопируйте данный файл в .env или экспортируйте переменные в терминале

# Базовый URL бэкенда (Render / Staging / Localhost)
# Внимание: Spring Boot настроен с server.servlet.context-path: /api
TARGET_URL=https://medev-backend.onrender.com/api

# Учетные данные администратора (для сценария Admin Flow)
MEDEV_ADMIN_EMAIL=admin@medev.mrsgemaseny.com
MEDEV_ADMIN_PASSWORD=YourAdminSecurePassword

# Учетные данные предзагруженного пользователя (для сценариев User Flow / AI Flow / GitHub Flow)
# Если эти переменные не заданы, Artillery автоматически зарегистрирует нового уникального пользователя на лету.
MEDEV_USER_EMAIL=testuser@medev.mrsgemaseny.com
MEDEV_USER_PASSWORD=YourUserSecurePassword123!
